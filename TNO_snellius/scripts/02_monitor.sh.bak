#!/usr/bin/env bash
# Live EKF monitor.
#
# Polls squeue every $INTERVAL seconds. When a job from this v2 sweep finishes,
# pulls its EAR reading via `eacct -j JOBID -l -c <csv>`, parses energy, and
# calls the EKF update step. Prints the tightened CI for remaining stages.
#
# State persists in $MEAS_DIR/ekf_state.json so you can ctrl-C and resume.
#
# Pre-req: $MEAS_DIR/ols_fits.json from 04_fit_ridge.py (initial fit on whatever
# data you already have — re-fit periodically as more rows accumulate).
#
# Usage:
#   source env.sh
#   bash 02_monitor.sh                  # watch all this-user jobs
#   bash 02_monitor.sh size25000_rep1   # only watch one run's pipeline

set -euo pipefail
source "$(dirname "$0")/env.sh"

INTERVAL="${MONITOR_INTERVAL:-30}"
SLUG_FILTER="${1:-}"

FITS="$MEAS_DIR/ols_fits.json"
STATE="$MEAS_DIR/ekf_state.json"
SEEN="$MEAS_DIR/ekf_seen_jobs.txt"

[ -f "$FITS" ] || { echo "No $FITS — run 03_harvest.sh + 04_fit_ridge.py first."; exit 1; }
touch "$SEEN"

# Initialise EKF state if missing
if [ ! -f "$STATE" ]; then
  N0="${N0:-100000}"; T0="${T0:-583}"
  python3 - "$FITS" "$STATE" "$N0" "$T0" <<'PY'
import json, sys
fits_path, state_path, n0, t0 = sys.argv[1:5]
n0 = float(n0); t0 = float(t0)
json.dump({"x": [n0, t0],
           "P": [[(0.08*n0)**2, 0], [0, (0.05*t0)**2]],
           "history": []}, open(state_path, "w"), indent=2)
print(f"[monitor] initialized EKF state at {state_path}  x0=[{n0},{t0}]")
PY
fi

# ── one-shot: handle a finished job ────────────────────────────────────────
handle_finished_job() {
  local jobid="$1" stage="$2"
  local csv
  csv=$(mktemp)
  if ! eacct -j "$jobid" -l -c "$csv" > /dev/null 2>&1; then
    echo "  WARN: eacct failed for $jobid"
    rm -f "$csv"
    return
  fi

  # _monitor_update.py reads the eacct CSV, applies the EKF update, prints
  # remaining-stage CI, and persists the new state.
  python3 "$(dirname "$0")/_monitor_update.py" "$csv" "$FITS" "$STATE" "$stage"

  rm -f "$csv"
}

# Tiny helper script we drop next to the monitor (avoids escaping hell in heredocs).
cat > "$(dirname "$0")/_monitor_update.py" <<'PY'
import csv, json, sys
from pathlib import Path
sys.path.insert(0, str(Path(__file__).resolve().parent))
from lib_ekf import PipelineEKF

csv_path, fits_path, state_path, stage = sys.argv[1:5]
with open(csv_path) as f:
    row = next(csv.DictReader(f, delimiter=';'), None)
if not row:
    sys.exit(0)

E_obs = float(row.get("DC_NODE_POWER_W", 0) or 0) * float(row.get("TIME_SEC", 0) or 0)
if E_obs <= 0:
    sys.exit(0)

state = json.load(open(state_path))
ekf = PipelineEKF(fits_path, n0=state["x"][0], t0=state["x"][1])
import numpy as np
ekf.P = np.array(state["P"]); ekf.history = state["history"]
ekf.update(stage, E_obs)

state["x"] = ekf.x.tolist()
state["P"] = ekf.P.tolist()
state["history"] = ekf.history
json.dump(state, open(state_path, "w"), indent=2)

STAGES = ["data_splitting", "string_normalization", "heuristic_filtering", "deduplication"]
# Only predict stages that actually have a fit in ols_fits.json — deduplication
# has no v2 fit yet, and predicting it would KeyError in lib_ekf._E_hat.
remaining = [s for s in STAGES[STAGES.index(stage)+1:] if s in ekf.fits] \
            if stage in STAGES else []
if remaining:
    rows = ekf.predict_all(remaining)
    total_E = sum(r["E_hat"] for r in rows)
    total_std = (sum(r["std"]**2 for r in rows))**0.5
    print(f"  remaining: {total_E/1e3:.1f} kJ ± {2*total_std/1e3:.1f} kJ  ({len(remaining)} stages)")
PY

# ── poll loop ──────────────────────────────────────────────────────────────
echo "[monitor] polling squeue every ${INTERVAL}s.  filter='${SLUG_FILTER}'"
echo "[monitor] state: $STATE   fits: $FITS"
echo "[monitor] ctrl-C to stop."

while true; do
  # Find recently completed jobs from this user that we haven't processed yet.
  # We pull sacct (not squeue — once a job leaves the queue squeue forgets it).
  sacct -u "$USER" --format=JobID,JobName,State,End --noheader -P \
       --starttime="$(date -u -d '12 hours ago' +%Y-%m-%dT%H:%M:%S 2>/dev/null \
                     || date -u -v-12H +%Y-%m-%dT%H:%M:%S)" \
       2>/dev/null \
  | grep -E "COMPLETED|FAILED|TIMEOUT" \
  | while IFS='|' read -r jobid jobname state endtime; do
      jobid_base="${jobid%%.*}"
      jobid_base="${jobid_base%%_*}"
      # Skip step entries (".batch", ".extern") and already-seen
      [[ "$jobid" == *.* ]] && continue
      grep -qx "$jobid_base" "$SEEN" && continue
      # Filter by jobname matching one of our stage names
      stage=""
      for s in "${STAGES[@]}"; do
        if [[ "$jobname" == "$s" ]]; then stage="$s"; break; fi
      done
      [ -z "$stage" ] && continue

      # Slug filter: if a run slug was given as $1, skip jobs that don't belong
      # to that pipeline. A job's run is identified by its SLURM log, which
      # Datatrove writes under runs/<slug>/pipeline*/stage*_<stage>/slurm_logs/.
      # Without this, a concurrent multi-pipeline sweep feeds ONE EKF and the
      # sequential prediction is meaningless.
      if [ -n "$SLUG_FILTER" ]; then
        if ! find "$RUNS_DIR/$SLUG_FILTER" \
               -path "*/stage*_${stage}/slurm_logs/${jobid_base}*" \
               -print -quit 2>/dev/null | grep -q .; then
          continue
        fi
      fi

      echo "[$(date -u +%H:%M:%S)] $jobid_base  $jobname  $state"
      # Only a COMPLETED job carries a valid energy reading. FAILED/TIMEOUT jobs
      # are reported for visibility but must NOT update the EKF — their partial
      # eacct reading would corrupt the sequential prediction.
      if [ "$state" = "COMPLETED" ]; then
        handle_finished_job "$jobid_base" "$stage" || true
      else
        echo "  skip: state=$state — not feeding a non-COMPLETED job to the EKF"
      fi
      echo "$jobid_base" >> "$SEEN"
    done

  sleep "$INTERVAL"
done
